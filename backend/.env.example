# Copy to backend/.env and fill in. Never commit the real .env.
# Keys are read server-side only; none of these reach the browser.

# --- LLM providers --------------------------------------------------------
# Chain order, tried left to right. Providers with no key are skipped.
LLM_PROVIDER_ORDER=ibm,groq,nvidia,gemini,openai,deepseek

# IBM watsonx.ai (Granite) — primary. Two things this needs that no other
# provider does: IBM_BOB_API_KEY is an IBM Cloud API key (exchanged for a
# short-lived IAM bearer token internally, not sent as-is), and every
# inference call is scoped to a watsonx project, so IBM_PROJECT_ID is
# required too — an API key alone will authenticate but every request will
# still fail without it. IBM_REGION defaults to us-south.
IBM_BOB_API_KEY=
IBM_PROJECT_ID=
IBM_BOB_MODEL=ibm/granite-3-8b-instruct
IBM_REGION=us-south

# Secondary primary (per project spec)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Documented alternative / fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional extra fallbacks
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# The app runs with NO keys at all: intake falls back to a deterministic
# multilingual question bank and the safety engine is unaffected.

# --- Doctor access --------------------------------------------------------
# Demo-grade only. Replace with a real identity provider before any real use.
DOCTOR_USERNAME=doctor
DOCTOR_PASSWORD=change-me-before-demo
DOCTOR_ID=DR-101
DOCTOR_NAME=Dr. Sharma, MD

# --- Letterhead (printable prescription) -----------------------------------
# Display-only identity for the printed/PDF prescription. Not authenticated,
# carries no clinical content — see shared/clinic.py.
HOSPITAL_NAME=Clinical Assistant General Hospital
HOSPITAL_ADDRESS=123 Health Street, Bengaluru, Karnataka 560001
HOSPITAL_PHONE=+91 80 1234 5678
HOSPITAL_REGISTRATION_NO=KA/HOSP/2026/00000
DOCTOR_QUALIFICATION=MBBS, MD (General Medicine)
DOCTOR_REGISTRATION_NO=KMC/00000/2026

# --- Runtime --------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# Persistence: JSON snapshot + append-only audit log. Set to 0 for ephemeral.
PERSIST_STATE=1
DATA_DIR=
SEED_DEMO_DATA=1

# Override the curated clinical knowledge directory (defaults to ../knowledge)
KNOWLEDGE_DIR=
